{
	"/helper/controller/simple/select_to_trigger": {
		"helper": true,
		"bindings": {
			"/user/hand/left/input/select": "/user/hand/left/input/trigger/value",
			"/user/hand/left/input/select/click": "/user/hand/left/input/trigger/value",
			"/user/hand/right/input/select": "/user/hand/right/input/trigger/value",
			"/user/hand/right/input/select/click": "/user/hand/right/input/trigger/value"
		}
	},
	"/helper/controller/simple/to_controller": {
		"helper": true,
		"helpers": [
			"/helper/controller/identity/output",
			"/helper/controller/identity/poses",
			"/helper/controller/simple/select_to_trigger"
		]
	},
	"/helper/controller/simple/to_menu_controller": {
		"helper": true,
		"helpers": [
			"/helper/controller/identity/menu",
			"/helper/controller/simple/to_controller"
		]
	},
	"/helper/controller/simple/to_left_menu_controller": {
		"helper": true,
		"helpers": ["/helper/controller/simple/to_controller"],
		"bindings": {
			"/user/hand/left/input/menu": true,
			"/user/hand/left/input/menu/click": true,
			"/user/hand/right/input/menu": false,
			"/user/hand/right/input/menu/click": false
		}
	},
	"/helper/controller/simple/right_menu_to_system": {
		"helper": true,
		"bindings": {
			"/user/hand/left/input/menu": true,
			"/user/hand/left/input/menu/click": true,
			"/user/hand/right/input/menu": "/user/hand/right/input/system",
			"/user/hand/right/input/menu/click": "/user/hand/right/input/system/click"
		}
	},
	"/helper/controller/simple/select_identifier_to_trigger": {
		"helper": true,
		"bindings": {
			"/user/hand/left/input/select": "/user/hand/left/input/trigger",
			"/user/hand/left/input/select/click": "/user/hand/left/input/trigger/value",
			"/user/hand/right/input/select": "/user/hand/right/input/trigger",
			"/user/hand/right/input/select/click": "/user/hand/right/input/trigger/value"
		}
	}
}
